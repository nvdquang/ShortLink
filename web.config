<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action
            type="Redirect"
            url="https://slink.hopto.org/{R:1}"
            redirectType="Permanent" />
        </rule>

        <rule name="Proxy to ShortLink Next.js" stopProcessing="true">
          <match url="(.*)" />
          <action
            type="Rewrite"
            url="http://127.0.0.1:3333/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>