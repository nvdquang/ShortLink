# ==== Email SMTP config cho ShortLink ====
# Điền thông tin SMTP của bạn rồi khởi động lại server (npm run dev).

# Gmail (khuyên dùng): tạo App Password tại https://myaccount.google.com/apppasswords
# (cần bật xác minh 2 bước trên tài khoản Google trước)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shortlink.active@gmail.com
SMTP_PASS=SL@Admin2026
SMTP_FROM=shortlink.active@gmail.com

# Hoặc Outlook/Office365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# URL gốc của ứng dụng — dùng để tạo link trong email.
# Khi triển khai thật, đổi thành domain thật (vd: https://slink.vn)
APP_URL=http://localhost:3000
